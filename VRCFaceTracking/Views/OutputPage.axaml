<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:VRCFaceTracking.ViewModels"
    xmlns:svc="using:VRCFaceTracking.Services"
    xmlns:models="clr-namespace:VRCFaceTracking.Models"
    x:DataType="vm:OutputViewModel"
    x:Class="VRCFaceTracking.Views.OutputPage">

    <Grid RowDefinitions="Auto,Auto,*">

        <Border Grid.Row="0" CornerRadius="6" BorderThickness="1" Padding="8,6" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button ToolTip.Tip="Copy all to clipboard" Click="CopyToClipboard_Click" Padding="8">
                    <ui:SymbolIcon Symbol="Copy" FontSize="16" />
                </Button>
                <Button ToolTip.Tip="Save to file" Click="SaveToFile_Click" Padding="8">
                    <ui:SymbolIcon Symbol="Save" FontSize="16" />
                </Button>
                <Separator />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.6" FontSize="12" Margin="8,0" />
            </StackPanel>
        </Border>

        <Expander Grid.Row="1" Header="Native Face Data (/tracking/face/v1) - live preview" Margin="0,0,0,10">
            <StackPanel Spacing="8" Margin="4">
                <TextBlock Text="{Binding NativeStatus}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                <TextBlock Text="{Binding EyeSummary}" FontFamily="Cascadia Mono, Consolas, Courier New, monospace" FontSize="13" />
                <TextBlock Text="{Binding DiagnosticHint}" FontSize="12" Foreground="#FFC107" TextWrapping="Wrap"
                           IsVisible="{Binding DiagnosticHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ItemsControl ItemsSource="{Binding BlobCells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BlobCell">
                            <Border Width="13" Height="13" Margin="1" CornerRadius="2"
                                    Background="{Binding Brush}" ToolTip.Tip="{Binding Tooltip}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                           Text="Each cell is one tracking key in VRChat's payload order (hover for name and value). Cells #0-7 are eye look - hover them while moving your eyes. #8-9 are eye closed. #14+ are face expressions. Cells are what would be put on the wire for /tracking/face/v1." />
            </StackPanel>
        </Expander>

        <Border Grid.Row="2" CornerRadius="6" BorderThickness="1" Padding="4"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <ListBox x:Name="LogItems"
                     ItemsSource="{Binding Logs}"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.AllowAutoHide="False">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                    <Style Selector="ListBox /template/ ScrollViewer">
                        <Setter Property="Padding" Value="0,0,0,16" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:LogLine">
                        <TextBlock
                            x:Name="LogText"
                            Text="{Binding Message}"
                            FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                            FontSize="12"
                            Padding="6,1"
                            TextWrapping="NoWrap"
                            Foreground="{Binding Level, Converter={StaticResource LogLevelBrushConverter}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
